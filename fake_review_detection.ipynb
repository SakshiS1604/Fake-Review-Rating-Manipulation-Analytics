<ul data-start="2435" data-end="2534">
<li data-start="2435" data-end="2468">
<p data-start="2437" data-end="2468">Creates many <strong data-start="2450" data-end="2468">decision trees</strong></p>
</li>
<li data-start="2469" data-end="2499">
